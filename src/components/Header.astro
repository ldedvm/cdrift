---
import { withBase } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<a href={withBase('/')} class="logo">cdrift</a>
		<div class="links">
			<HeaderLink href={withBase('/')}>首页</HeaderLink>
			<HeaderLink href={withBase('/blog')}>笔记</HeaderLink>
			<HeaderLink href={withBase('/graph')}>图谱</HeaderLink>
			<HeaderLink href={withBase('/about')}>关于</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 30;
		background: rgba(245, 243, 239, 0.85);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		border-bottom: 1px solid var(--hairline-soft);
	}
	/* 导航通栏：logo 顶到最左，链接贴最右 */
	nav {
		padding: 0 clamp(1.5em, 4vw, 3.5em);
		height: 64px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1em;
	}
	.logo {
		font-size: 1.35rem;
		font-weight: 800;
		letter-spacing: 0.3em;
		color: var(--ink);
		text-decoration: none;
	}
	.links {
		display: flex;
		gap: 2.4em;
	}
	nav a:not(.logo) {
		font-size: 0.95rem;
		letter-spacing: 0.14em;
		color: var(--muted);
		text-decoration: none;
		transition: color 0.2s ease;
		padding: 1.35em 0;
	}
	nav a:not(.logo):hover {
		color: var(--ink);
	}
	nav a:not(.logo).active {
		color: var(--ink);
		font-weight: 600;
	}
	@media (max-width: 720px) {
		.links {
			gap: 1.3em;
		}
		nav a:not(.logo) {
			font-size: 0.85rem;
		}
	}
</style>
