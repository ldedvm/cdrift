---
// 知识图谱的首页预览：小画布上的网络缓缓漂浮（笔记=实心点，标签=空心圈）。
// 数据由父页面传入；整块区域不可交互，点击走「进入图谱」按钮。
const { nodes, links } = Astro.props;
const data = JSON.stringify({ nodes, links });
---

<div class="mini">
	<canvas class="mini-canvas" aria-hidden="true"></canvas>
	<script is:inline type="application/json" id="mini-graph-data" set:html={data} />
</div>

<style>
	.mini {
		position: relative;
		height: 100%;
		min-height: 320px;
	}
	.mini-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script>
	const dataEl = document.getElementById('mini-graph-data');
	const canvas = document.querySelector('.mini-canvas');
	if (dataEl && canvas) {
		const raw = JSON.parse(dataEl.textContent || '{"nodes":[],"links":[]}');
		const ctx = canvas.getContext('2d');
		if (ctx) {
			let w = 0;
			let h = 0;
			let nodes = [];

			function resize() {
				const rect = canvas.parentElement.getBoundingClientRect();
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				w = rect.width;
				h = rect.height;
				canvas.width = w * dpr;
				canvas.height = h * dpr;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				const R = Math.min(w, h) * 0.34;
				nodes = raw.nodes.map((n, i) => {
					const a = (i / Math.max(raw.nodes.length, 1)) * Math.PI * 2 - Math.PI / 2;
					return {
						...n,
						bx: w / 2 + Math.cos(a) * R,
						by: h / 2 + Math.sin(a) * R,
						x: 0,
						y: 0,
						phase: Math.random() * Math.PI * 2,
						speed: 0.4 + Math.random() * 0.5,
						amp: 7 + Math.random() * 8,
						isTag: n.kind === 'tag',
					};
				});
			}

			function draw(t) {
				ctx.clearRect(0, 0, w, h);
				for (const n of nodes) {
					n.x = n.bx + Math.sin(n.phase + t * n.speed) * n.amp;
					n.y = n.by + Math.cos(n.phase * 1.3 + t * n.speed * 0.9) * n.amp;
				}
				ctx.lineWidth = 1;
				ctx.strokeStyle = 'rgba(23, 25, 29, 0.16)';
				for (const l of raw.links) {
					const a = nodes.find((n) => n.id === l.source);
					const b = nodes.find((n) => n.id === l.target);
					if (!a || !b) continue;
					ctx.beginPath();
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
					ctx.stroke();
				}
				for (const n of nodes) {
					ctx.beginPath();
					if (n.isTag) {
						ctx.arc(n.x, n.y, 4, 0, Math.PI * 2);
						ctx.strokeStyle = 'rgba(23, 25, 29, 0.5)';
						ctx.stroke();
					} else {
						ctx.arc(n.x, n.y, 5, 0, Math.PI * 2);
						ctx.fillStyle = 'rgba(23, 25, 29, 0.88)';
						ctx.fill();
					}
					// 节点太多时只画点不画字，避免糊成一片
					if (raw.nodes.length <= 16) {
						ctx.font = '11px -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif';
						ctx.fillStyle = n.isTag ? 'rgba(23,25,29,0.35)' : 'rgba(23, 25, 29, 0.6)';
						ctx.textAlign = 'center';
						ctx.fillText(n.title, n.x, n.y + 20);
					}
				}
			}

			window.addEventListener('resize', resize);
			resize();

			// 滚出视口时暂停重绘，省性能
			let visible = true;
			new IntersectionObserver((entries) => {
				visible = entries[0].isIntersecting;
			}).observe(canvas);

			if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				draw(0);
			} else {
				const loop = (n) => {
					if (visible) draw(n / 1000);
					requestAnimationFrame(loop);
				};
				requestAnimationFrame(loop);
			}
		}
	}
</script>
