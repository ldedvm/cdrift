---
import { withBase } from '../consts';
const today = new Date();
---

<footer>
	<p class="ghost" aria-hidden="true">cdrift</p>
	<div class="inner">
		<p>&copy; {today.getFullYear()} CD · cdrift</p>
		<p class="right">
			<a href={withBase('/rss.xml')}>RSS</a>
			<span aria-hidden="true"> · </span>
			<a href="https://astro.build/" target="_blank">Powered by Astro</a>
		</p>
	</div>
</footer>
<style>
	footer {
		position: relative;
		overflow: hidden;
		border-top: 1px solid var(--hairline-soft);
		margin-top: 2em;
	}
	.ghost {
		position: absolute;
		bottom: -0.24em;
		left: 50%;
		transform: translateX(-50%);
		font-size: clamp(7rem, 19vw, 17rem);
		font-weight: 800;
		letter-spacing: 0.06em;
		line-height: 1;
		color: rgba(23, 25, 29, 0.045);
		white-space: nowrap;
		pointer-events: none;
		margin: 0;
	}
	.inner {
		position: relative;
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 2.2em 1.5em 3em;
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1em;
		flex-wrap: wrap;
	}
	footer p {
		margin: 0;
		font-size: 0.78rem;
		letter-spacing: 0.08em;
		color: var(--faint);
	}
	footer a {
		color: var(--faint);
		text-decoration: none;
	}
	footer a:hover {
		color: var(--text);
	}
</style>
