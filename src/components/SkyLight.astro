---
// 浅色页面的背景：一张缓缓呼吸的「星图手稿」。
// 米白纸面 + 三团漂移星云 + 偏心轨道弧 + 两组星座连线 + 一枚旋转的墨点小星系
// + 偶尔划过的流星 + 细星尘，整层随滚动轻微视差。
// fixed 全屏、z-index -1，自绘不透明底色，直接充当浅色页面的"纸"。
// 深色页面（首屏、图谱）不要引入。
---

<canvas id="skylight" aria-hidden="true"></canvas>

<style>
	#skylight {
		position: fixed;
		inset: 0;
		z-index: -1;
		pointer-events: none;
	}
</style>

<script>
	const canvas = document.getElementById('skylight');
	if (canvas) {
		const ctx = canvas.getContext('2d');
		if (ctx) {
			const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let w = 0;
			let h = 0;
			let specks = [];
			let constellations = [];
			let inkGalaxy = null;
			let scrollOff = 0;
			let scrollTarget = 0;
			let meteor = null;
			let nextMeteorAt = 6000;

			const gauss = () => (Math.random() + Math.random() + Math.random() - 1.5) / 1.5;

			// 星云雾：颜色呼应首屏银河（琥珀 / 冷蓝 / 微紫），负责色彩纵深
			const blobs = [
				{ color: '217, 132, 73', a: 0.15, r: 0.38, sx: 0.8, sy: 0.14, ax: 0.09, ay: 0.05, sp: 0.05, ph: 0 },
				{ color: '108, 138, 214', a: 0.13, r: 0.42, sx: 0.14, sy: 0.8, ax: 0.07, ay: 0.06, sp: 0.04, ph: 2 },
				{ color: '150, 112, 214', a: 0.1, r: 0.34, sx: 0.55, sy: 1.04, ax: 0.05, ay: 0.05, sp: 0.033, ph: 4 },
			];

			// 星座群：7-9 颗星 + 细连线
			function buildConstellation(cx, cy, spread) {
				const stars = [];
				const n = 7 + ((Math.random() * 3) | 0);
				for (let i = 0; i < n; i++) {
					stars.push({
						x: cx + gauss() * spread,
						y: cy + gauss() * spread * 0.72,
						r: 1.1 + Math.random() * 1.2,
						a: 0.26 + Math.random() * 0.24,
					});
				}
				const links = [];
				for (let i = 0; i < stars.length - 1; i++) {
					links.push([i, i + 1]);
					if (Math.random() < 0.45) links.push([i, (i + 2) % stars.length]);
				}
				return {
					stars,
					links,
					ox: gauss() * 26,
					oy: gauss() * 22,
					sp: 0.02 + Math.random() * 0.02,
					ph: Math.random() * 6,
				};
			}

			// 墨点小星系：百余颗细点旋成的小旋涡，极慢自转
			function buildInkGalaxy(cx, cy, R) {
				const pts = [];
				const N = 170;
				for (let i = 0; i < N; i++) {
					const t = Math.pow(Math.random(), 1.6);
					const r = R * (0.15 + 0.85 * t);
					const ang = (i % 2) * Math.PI + (r / R) * 3.2 + gauss() * 0.3;
					pts.push({ r, ang, a: 0.1 + Math.random() * 0.26, s: 0.35 + Math.random() * 0.75 });
				}
				return { pts, cx, cy, R, rot: Math.random() * 6 };
			}

			function resize() {
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				w = window.innerWidth;
				h = window.innerHeight;
				canvas.width = w * dpr;
				canvas.height = h * dpr;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				specks = Array.from(
					{ length: Math.min(240, Math.floor((w * h) / 9500)) },
					() => ({
						x: Math.random() * w,
						y: Math.random() * h,
						r: 0.5 + Math.random() * 1.3,
						a: 0.09 + Math.random() * 0.17,
						ph: Math.random() * Math.PI * 2,
						sp: 0.3 + Math.random() * 0.9,
					}),
				);
				constellations = [
					buildConstellation(w * 0.79, h * 0.2, Math.min(w, h) * 0.13),
					buildConstellation(w * 0.13, h * 0.74, Math.min(w, h) * 0.11),
				];
				inkGalaxy = buildInkGalaxy(w * 0.87, h * 0.8, Math.min(w, h) * 0.17);
			}

			// 视差回绕：元素随滚动上移，滑出顶部后从底部回来
			const wrapY = (y, off) => {
				const H = h + 260;
				return (((y - off) % H) + H) % H - 130;
			};

			function draw(t) {
				// 纸面底色（不透明，这张画布就是浅色页面本身）
				ctx.fillStyle = '#f5f3ef';
				ctx.fillRect(0, 0, w, h);

				// 星云雾
				for (const b of blobs) {
					const x = (b.sx + Math.sin(t * b.sp + b.ph) * b.ax) * w;
					const y = (b.sy + Math.cos(t * b.sp * 0.8 + b.ph) * b.ay) * h;
					const r = b.r * Math.max(w, h) * 0.75;
					const g = ctx.createRadialGradient(x, y, 0, x, y, r);
					g.addColorStop(0, `rgba(${b.color},${b.a})`);
					g.addColorStop(0.55, `rgba(${b.color},${(b.a * 0.4).toFixed(3)})`);
					g.addColorStop(1, `rgba(${b.color},0)`);
					ctx.fillStyle = g;
					ctx.fillRect(0, 0, w, h);
				}

				// 偏心轨道弧
				ctx.strokeStyle = 'rgba(23, 25, 29, 0.075)';
				ctx.lineWidth = 1;
				for (const m of [0.5, 0.74, 1.0]) {
					ctx.beginPath();
					ctx.ellipse(
						w * 0.87,
						h * 0.14,
						Math.max(w, h) * m * 0.42,
						Math.max(w, h) * m * 0.3,
						-0.24,
						0,
						Math.PI * 2,
					);
					ctx.stroke();
				}

				// 星座连线群
				for (const c of constellations) {
					const ox = c.ox * Math.sin(t * c.sp + c.ph);
					const oy = c.oy * Math.cos(t * c.sp * 0.8 + c.ph);
					ctx.strokeStyle = 'rgba(23, 25, 29, 0.11)';
					ctx.beginPath();
					for (const [a, b] of c.links) {
						ctx.moveTo(c.stars[a].x + ox, wrapY(c.stars[a].y + oy, scrollOff));
						ctx.lineTo(c.stars[b].x + ox, wrapY(c.stars[b].y + oy, scrollOff));
					}
					ctx.stroke();
					for (const s of c.stars) {
						ctx.beginPath();
						ctx.arc(s.x + ox, wrapY(s.y + oy, scrollOff), s.r, 0, Math.PI * 2);
						ctx.fillStyle = `rgba(23, 25, 29, ${s.a})`;
						ctx.fill();
					}
				}

				// 墨点小星系（极慢自转）
				if (inkGalaxy) {
					const g = inkGalaxy;
					if (!REDUCE) g.rot += 0.0009;
					for (const p of g.pts) {
						const a = p.ang + g.rot;
						const x = g.cx + Math.cos(a) * p.r;
						const y = wrapY(g.cy + Math.sin(a) * p.r * 0.82, scrollOff * 1.15);
						ctx.beginPath();
						ctx.arc(x, y, p.s, 0, Math.PI * 2);
						ctx.fillStyle = `rgba(23, 25, 29, ${p.a})`;
						ctx.fill();
					}
				}

				// 星尘
				for (const s of specks) {
					const tw = 0.6 + 0.4 * Math.sin(s.ph + t * s.sp);
					const y = wrapY(s.y, scrollOff * 0.5);
					ctx.beginPath();
					ctx.arc(s.x, y, s.r, 0, Math.PI * 2);
					ctx.fillStyle = `rgba(23, 25, 29, ${(s.a * tw).toFixed(3)})`;
					ctx.fill();
				}

				// 流星：每隔一阵划过一颗
				if (!REDUCE) {
					if (!meteor && t * 1000 > nextMeteorAt) {
						meteor = {
							x: w * (0.15 + Math.random() * 0.7),
							y: -20,
							vx: -1.3 - Math.random(),
							vy: 2.2 + Math.random(),
							life: 0,
						};
					}
					if (meteor) {
						meteor.life += 1 / 60;
						meteor.x += meteor.vx;
						meteor.y += meteor.vy;
						const fade = Math.max(0, 1 - meteor.life / 1.2);
						const grad = ctx.createLinearGradient(
							meteor.x,
							meteor.y,
							meteor.x - meteor.vx * 26,
							meteor.y - meteor.vy * 26,
						);
						grad.addColorStop(0, `rgba(23, 25, 29, ${(0.32 * fade).toFixed(3)})`);
						grad.addColorStop(1, 'rgba(23, 25, 29, 0)');
						ctx.strokeStyle = grad;
						ctx.lineWidth = 1.2;
						ctx.beginPath();
						ctx.moveTo(meteor.x, meteor.y);
						ctx.lineTo(meteor.x - meteor.vx * 26, meteor.y - meteor.vy * 26);
						ctx.stroke();
						if (fade <= 0 || meteor.y > h + 40) {
							meteor = null;
							nextMeteorAt = t * 1000 + 9000 + Math.random() * 9000;
						}
					}
				}
			}

			window.addEventListener('resize', resize);
			window.addEventListener(
				'scroll',
				() => {
					scrollTarget = window.scrollY * 0.05;
				},
				{ passive: true },
			);
			resize();

			if (REDUCE) {
				draw(0);
			} else {
				const loop = (n) => {
					scrollOff += (scrollTarget - scrollOff) * 0.06;
					draw(n / 1000);
					requestAnimationFrame(loop);
				};
				requestAnimationFrame(loop);
			}
		}
	}
</script>
