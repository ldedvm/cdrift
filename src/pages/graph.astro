---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Stars from '../components/Stars.astro';
import { buildGraph } from '../lib/graph.js';
import { SITE_TITLE } from '../consts';

const posts = await getCollection('blog');
const { nodes, links } = buildGraph(posts);
const graph = JSON.stringify({ nodes, links });
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`知识图谱 · ${SITE_TITLE}`} description="笔记之间的双链网络" />
	</head>
	<body>
		<Header />
		<main class="stage theme-dark">
			<Stars />
			<div class="hud">
				<p class="label">知识图谱 · Graph</p>
				<p class="hint">{nodes.length} 篇笔记 · {links.length} 条连接 — 拖动节点，点击进入；双指或滚轮缩放</p>
				<button id="fit-btn" type="button">⤢ 全览</button>
			</div>
			<canvas id="graph-canvas" aria-label="笔记知识图谱"></canvas>
			<script is:inline type="application/json" id="graph-data" set:html={graph} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.stage {
		position: relative;
		height: calc(100vh - 60px);
		min-height: 480px;
		overflow: hidden;
		background: var(--bg);
	}
	#graph-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: none;
	}
	.hud {
		position: absolute;
		top: 2em;
		left: 0;
		right: 0;
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 1.5em;
		pointer-events: none;
		z-index: 1;
	}
	#fit-btn {
		margin-top: 0.8em;
		padding: 0.45em 1.1em;
		font: 600 0.75rem/1 -apple-system, 'Segoe UI', 'Microsoft YaHei', sans-serif;
		letter-spacing: 0.1em;
		color: var(--muted);
		background: rgba(255, 255, 255, 0.06);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		cursor: pointer;
		pointer-events: auto;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	#fit-btn:hover {
		color: #fff;
		border-color: rgba(255, 255, 255, 0.6);
	}
	.hint {
		color: var(--faint);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		margin: 0.4em 0 0;
	}
</style>

<script>
	const dataEl = document.getElementById('graph-data');
	const canvas = document.getElementById('graph-canvas');
	const fitBtn = document.getElementById('fit-btn');
	if (dataEl && canvas) {
		const ctx = canvas.getContext('2d');
		if (ctx) {
			const raw = JSON.parse(dataEl.textContent || '{"nodes":[],"links":[]}');
			const REDUCE = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			let dpr = 1;
			let w = 0;
			let h = 0;
			let nodes = [];
			const links = raw.links;
			const nodeById = new Map();
			const degrees = new Map();
			for (const l of links) {
				degrees.set(l.source, (degrees.get(l.source) || 0) + 1);
				degrees.set(l.target, (degrees.get(l.target) || 0) + 1);
			}

			// 视图变换：屏幕坐标 = 世界坐标 * scale + 偏移
			const view = { x: 0, y: 0, scale: 1 };
			let userModified = false; // 用户一旦缩放/平移，就不再自动适配

			const toWorld = (sx, sy) => ({ x: (sx - view.x) / view.scale, y: (sy - view.y) / view.scale });
			const toScreen = (x, y) => ({ x: x * view.scale + view.x, y: y * view.scale + view.y });

			function resize() {
				const rect = canvas.parentElement.getBoundingClientRect();
				dpr = Math.min(window.devicePixelRatio || 1, 2);
				w = rect.width;
				h = rect.height;
				canvas.width = w * dpr;
				canvas.height = h * dpr;
				const R = Math.min(w, h) * 0.42;
				nodes = raw.nodes.map((n, i) => {
					const a = (i / Math.max(raw.nodes.length, 1)) * Math.PI * 2;
					const degree = degrees.get(n.id) || 0;
					return {
						...n,
						x: w / 2 + Math.cos(a) * R + (Math.random() - 0.5) * 40,
						y: h / 2 + Math.sin(a) * R + (Math.random() - 0.5) * 40,
						vx: 0,
						vy: 0,
						// 平方根缩放 + 上限，避免枢纽节点变成巨圆
						r: Math.min(3 + Math.sqrt(degree) * 2.4, 26),
					};
				});
				nodeById.clear();
				for (const n of nodes) nodeById.set(n.id, n);
				userModified = false; // 重新自动适配
				alpha = 1;
				ensureLoop();
			}

			// 自动适配：把所有节点框进画布（留边距），返回目标视图
			function computeFit() {
				if (!nodes.length) return null;
				let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
				for (const n of nodes) {
					if (n.x < minX) minX = n.x;
					if (n.x > maxX) maxX = n.x;
					if (n.y < minY) minY = n.y;
					if (n.y > maxY) maxY = n.y;
				}
				const pad = 50;
				const bw = Math.max(maxX - minX, 1);
				const bh = Math.max(maxY - minY, 1);
				const scale = Math.max(0.04, Math.min((w - pad * 2) / bw, (h - pad * 2) / bh, 1.5));
				return {
					scale,
					x: w / 2 - ((minX + maxX) / 2) * scale,
					y: h / 2 - ((minY + maxY) / 2) * scale,
				};
			}

			function fitView() {
				userModified = false;
				alpha = Math.max(alpha, 0.1);
			}
			fitBtn?.addEventListener('click', fitView);

			let alpha = 1;
			let running = false;
			let hoverNode = null;
			let dragging = null;
			let dragMoved = false;
			let panLast = null;
			let pinch = null;
			const pointers = new Map();

			function tick() {
				// 力度跟随模拟活跃度：稳定后只剩零头，动作都变得柔和
				const fs = Math.min(1, alpha * 2.2);
				for (let i = 0; i < nodes.length; i++) {
					for (let j = i + 1; j < nodes.length; j++) {
						const a = nodes[i];
						const b = nodes[j];
						let dx = a.x - b.x;
						let dy = a.y - b.y;
						let d2 = dx * dx + dy * dy;
						if (d2 < 1) {
							dx = Math.random() - 0.5;
							dy = Math.random() - 0.5;
							d2 = 1;
						}
						const f = (750 / d2) * fs;
						const d = Math.sqrt(d2);
						a.vx += (dx / d) * f;
						a.vy += (dy / d) * f;
						b.vx -= (dx / d) * f;
						b.vy -= (dy / d) * f;
					}
				}
				for (const l of links) {
					const a = nodeById.get(l.source);
					const b = nodeById.get(l.target);
					if (!a || !b) continue;
					const dx = b.x - a.x;
					const dy = b.y - a.y;
					const d = Math.sqrt(dx * dx + dy * dy) || 1;
					const f = (d - 110) * 0.007 * fs;
					a.vx += (dx / d) * f;
					a.vy += (dy / d) * f;
					b.vx -= (dx / d) * f;
					b.vy -= (dy / d) * f;
				}
				for (const n of nodes) {
					n.vx += (w / 2 - n.x) * 0.003 * fs;
					n.vy += (h / 2 - n.y) * 0.003 * fs;
					n.vx *= 0.88;
					n.vy *= 0.88;
					n.vx = Math.max(-2.5, Math.min(2.5, n.vx));
					n.vy = Math.max(-2.5, Math.min(2.5, n.vy));
					if (n !== dragging) {
						n.x += n.vx;
						n.y += n.vy;
					}
				}
				alpha *= 0.995;
			}

			function draw(t) {
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ctx.clearRect(0, 0, w, h);

				// 世界层：节点与连线
				ctx.save();
				ctx.translate(view.x, view.y);
				ctx.scale(view.scale, view.scale);
				ctx.lineWidth = 1 / view.scale;
				ctx.strokeStyle = 'rgba(255, 255, 255, 0.26)';
				ctx.beginPath();
				for (const l of links) {
					const a = nodeById.get(l.source);
					const b = nodeById.get(l.target);
					if (!a || !b) continue;
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
				}
				ctx.stroke();
				for (const n of nodes) {
					const hovered = n === hoverNode;
					const isHub = (degrees.get(n.id) || 0) >= 8;
					ctx.beginPath();
					ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
					ctx.fillStyle = hovered ? '#ffffff' : isHub ? 'rgba(255, 255, 255, 0.95)' : 'rgba(255, 255, 255, 0.8)';
					ctx.fill();
					if (hovered) {
						ctx.beginPath();
						ctx.arc(n.x, n.y, n.r + 5 / view.scale, 0, Math.PI * 2);
						ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
						ctx.stroke();
					}
				}
				ctx.restore();

				// 标签层：屏幕空间绘制，字号不随缩放变形
				ctx.font = '12px -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif';
				ctx.textAlign = 'center';
				for (const n of nodes) {
					const isHub = (degrees.get(n.id) || 0) >= 8;
					const hovered = n === hoverNode;
					if (!(nodes.length <= 16 || isHub || hovered)) continue;
					const s = toScreen(n.x, n.y);
					if (s.x < -100 || s.x > w + 100 || s.y < -20 || s.y > h + 20) continue;
					ctx.fillStyle = hovered ? '#ffffff' : 'rgba(255, 255, 255, 0.5)';
					ctx.fillText(n.title, s.x, s.y + n.r * view.scale + 15);
				}
			}

			function ensureLoop() {
				if (running) return;
				running = true;
				const frame = (now) => {
					const t = now / 1000;
					if (alpha > 0.02 || dragging || pointers.size) tick();
					// 用户没动过视图时，温和地自动适配全览
					if (!userModified) {
						const fit = computeFit();
						if (fit) {
							view.x += (fit.x - view.x) * 0.08;
							view.y += (fit.y - view.y) * 0.08;
							view.scale += (fit.scale - view.scale) * 0.08;
						}
					}
					draw(t);
					requestAnimationFrame(frame);
				};
				requestAnimationFrame(frame);
			}

			function nodeAt(sx, sy) {
				const p = toWorld(sx, sy);
				for (const n of nodes) {
					const dx = n.x - p.x;
					const dy = n.y - p.y;
					if (dx * dx + dy * dy <= (n.r + 8 / view.scale) ** 2) return n;
				}
				return null;
			}

			function startPinch() {
				const pts = [...pointers.values()];
				const mid = { x: (pts[0].x + pts[1].x) / 2, y: (pts[0].y + pts[1].y) / 2 };
				pinch = {
					d: Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y) || 1,
					worldMid: toWorld(mid.x, mid.y),
					scale: view.scale,
				};
				dragging = null;
				panLast = null;
			}

			canvas.addEventListener('pointerdown', (e) => {
				canvas.setPointerCapture(e.pointerId);
				pointers.set(e.pointerId, { x: e.offsetX, y: e.offsetY });
				if (pointers.size === 1) {
					const n = nodeAt(e.offsetX, e.offsetY);
					if (n) {
						dragging = n;
						dragMoved = false;
						alpha = Math.max(alpha, 0.12);
						canvas.style.cursor = 'grabbing';
					} else {
						panLast = { x: e.offsetX, y: e.offsetY };
						userModified = true;
					}
				} else if (pointers.size === 2) {
					startPinch();
					userModified = true;
				}
			});

			canvas.addEventListener('pointermove', (e) => {
				const x = e.offsetX;
				const y = e.offsetY;
				if (pointers.has(e.pointerId)) pointers.set(e.pointerId, { x, y });

				if (pointers.size >= 2) {
					// 双指捏合缩放
					if (!pinch) startPinch();
					const pts = [...pointers.values()];
					const d = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y) || 1;
					const mid = { x: (pts[0].x + pts[1].x) / 2, y: (pts[0].y + pts[1].y) / 2 };
					view.scale = Math.max(0.05, Math.min(5, pinch.scale * (d / pinch.d)));
					view.x = mid.x - pinch.worldMid.x * view.scale;
					view.y = mid.y - pinch.worldMid.y * view.scale;
					alpha = Math.max(alpha, 0.1);
					return;
				}

				if (dragging) {
					const p = toWorld(x, y);
					dragging.x = p.x;
					dragging.y = p.y;
					dragging.vx = 0;
					dragging.vy = 0;
					dragMoved = true;
					alpha = Math.max(alpha, 0.12);
					userModified = true;
				} else if (panLast) {
					// 拖空白处平移视图
					view.x += x - panLast.x;
					view.y += y - panLast.y;
					panLast = { x, y };
				} else {
					hoverNode = nodeAt(x, y);
					canvas.style.cursor = hoverNode ? 'pointer' : 'default';
				}
			});

			function endPointer(e) {
				pointers.delete(e.pointerId);
				pinch = null;
				if (dragging && !dragMoved) {
					const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
					location.href = `${base}/blog/${dragging.id}/`;
				}
				dragging = null;
				panLast = null;
				hoverNode = null;
				canvas.style.cursor = 'default';
			}
			canvas.addEventListener('pointerup', endPointer);
			canvas.addEventListener('pointercancel', endPointer);

			// 桌面滚轮缩放（以光标为锚点）
			canvas.addEventListener(
				'wheel',
				(e) => {
					e.preventDefault();
					const rect = canvas.getBoundingClientRect();
					const mx = e.clientX - rect.left;
					const my = e.clientY - rect.top;
					const factor = Math.exp(-e.deltaY * 0.0015);
					const newScale = Math.max(0.05, Math.min(5, view.scale * factor));
					view.x = mx - (mx - view.x) * (newScale / view.scale);
					view.y = my - (my - view.y) * (newScale / view.scale);
					view.scale = newScale;
					userModified = true;
				},
				{ passive: false },
			);

			window.addEventListener('resize', resize);
			resize();

			if (REDUCE) {
				const fit = computeFit();
				if (fit) Object.assign(view, fit);
				draw(0);
			} else {
				ensureLoop();
			}
		}
	}
</script>


</html>
