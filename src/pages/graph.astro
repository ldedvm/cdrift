---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Stars from '../components/Stars.astro';
import { buildGraph } from '../lib/graph.js';
import { SITE_TITLE } from '../consts';

const posts = await getCollection('blog');
const { nodes, links } = buildGraph(posts);
const graph = JSON.stringify({ nodes, links });
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`知识图谱 · ${SITE_TITLE}`} description="笔记之间的双链网络" />
	</head>
	<body>
		<Header />
		<main class="stage theme-dark">
			<Stars />
			<div class="hud">
				<p class="label">知识图谱 · Graph</p>
				<p class="hint">{nodes.length} 篇笔记 · {links.length} 条连接 — 拖动节点，点击进入</p>
			</div>
			<canvas id="graph-canvas" aria-label="笔记知识图谱"></canvas>
			<script is:inline type="application/json" id="graph-data" set:html={graph} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.stage {
		position: relative;
		height: calc(100vh - 60px);
		min-height: 480px;
		overflow: hidden;
		background: var(--bg);
	}
	#graph-canvas {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
		touch-action: none;
	}
	.hud {
		position: absolute;
		top: 2em;
		left: 0;
		right: 0;
		max-width: var(--maxw);
		margin: 0 auto;
		padding: 0 1.5em;
		pointer-events: none;
		z-index: 1;
	}
	.hint {
		color: var(--faint);
		font-size: 0.8rem;
		letter-spacing: 0.06em;
		margin: 0.4em 0 0;
	}
</style>

<script>
	const dataEl = document.getElementById('graph-data');
	const canvas = document.getElementById('graph-canvas');
	if (dataEl && canvas) {
		const raw = JSON.parse(dataEl.textContent || '{"nodes":[],"links":[]}');
		const ctx = canvas.getContext('2d');
		if (ctx) {
			const degrees = new Map();
			for (const l of raw.links) {
				degrees.set(l.source, (degrees.get(l.source) || 0) + 1);
				degrees.set(l.target, (degrees.get(l.target) || 0) + 1);
			}

			let w = 0;
			let h = 0;
			let nodes = [];
			const links = raw.links;

			function resize() {
				const rect = canvas.parentElement.getBoundingClientRect();
				const dpr = Math.min(window.devicePixelRatio || 1, 2);
				w = rect.width;
				h = rect.height;
				canvas.width = w * dpr;
				canvas.height = h * dpr;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				const R = Math.min(w, h) * 0.32;
				nodes = raw.nodes.map((n, i) => {
					const a = (i / Math.max(raw.nodes.length, 1)) * Math.PI * 2;
					const degree = degrees.get(n.id) || 0;
					return {
						...n,
						x: w / 2 + Math.cos(a) * R + (Math.random() - 0.5) * 40,
						y: h / 2 + Math.sin(a) * R + (Math.random() - 0.5) * 40,
						vx: 0,
						vy: 0,
						// 平方根缩放 + 上限，避免枢纽节点变成巨圆
						r: Math.min(3 + Math.sqrt(degree) * 2.4, 26),
					};
				});
				nodeById.clear();
				for (const n of nodes) nodeById.set(n.id, n);
				alpha = 1;
				ensureLoop();
			}

			let alpha = 1;
			let running = false;

			function tick() {
				// 力度跟随模拟活跃度：初始布局全力，拖拽/稳定时只剩零头，松手才会缓缓归位
				const fs = Math.min(1, alpha * 2.2);
				// 斥力
				for (let i = 0; i < nodes.length; i++) {
					for (let j = i + 1; j < nodes.length; j++) {
						const a = nodes[i];
						const b = nodes[j];
						let dx = a.x - b.x;
						let dy = a.y - b.y;
						let d2 = dx * dx + dy * dy;
						if (d2 < 1) {
							dx = Math.random() - 0.5;
							dy = Math.random() - 0.5;
							d2 = 1;
						}
						const f = (750 / d2) * fs;
						const d = Math.sqrt(d2);
						a.vx += (dx / d) * f;
						a.vy += (dy / d) * f;
						b.vx -= (dx / d) * f;
						b.vy -= (dy / d) * f;
					}
				}
				// 连线弹力（软弹簧：低系数 + 加长自然长度）
				for (const l of links) {
					const a = nodes.find((n) => n.id === l.source);
					const b = nodes.find((n) => n.id === l.target);
					if (!a || !b) continue;
					const dx = b.x - a.x;
					const dy = b.y - a.y;
					const d = Math.sqrt(dx * dx + dy * dy) || 1;
					const f = (d - 110) * 0.007 * fs;
					a.vx += (dx / d) * f;
					a.vy += (dy / d) * f;
					b.vx -= (dx / d) * f;
					b.vy -= (dy / d) * f;
				}
				// 向心 + 阻尼 + 限速：每帧位移封顶，杜绝猛弹
				for (const n of nodes) {
					n.vx += (w / 2 - n.x) * 0.003 * fs;
					n.vy += (h / 2 - n.y) * 0.003 * fs;
					n.vx *= 0.88;
					n.vy *= 0.88;
					n.vx = Math.max(-2.5, Math.min(2.5, n.vx));
					n.vy = Math.max(-2.5, Math.min(2.5, n.vy));
					if (n !== dragging) {
						n.x += n.vx;
						n.y += n.vy;
					}
				}
				alpha *= 0.995;
			}

			function draw() {
				ctx.clearRect(0, 0, w, h);
				ctx.lineWidth = 1;
				ctx.strokeStyle = 'rgba(255, 255, 255, 0.26)';
				for (const l of links) {
					const a = nodeById.get(l.source);
					const b = nodeById.get(l.target);
					if (!a || !b) continue;
					ctx.beginPath();
					ctx.moveTo(a.x, a.y);
					ctx.lineTo(b.x, b.y);
					ctx.stroke();
				}
				for (const n of nodes) {
					const hovered = n === hoverNode;
					const isHub = (degrees.get(n.id) || 0) >= 8;
					ctx.beginPath();
					ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
					ctx.fillStyle = hovered ? '#ffffff' : isHub ? 'rgba(255, 255, 255, 0.95)' : 'rgba(255, 255, 255, 0.8)';
					ctx.fill();
					if (hovered) {
						ctx.beginPath();
						ctx.arc(n.x, n.y, n.r + 5, 0, Math.PI * 2);
						ctx.strokeStyle = 'rgba(255, 255, 255, 0.4)';
						ctx.stroke();
					}
					ctx.font = '12px -apple-system, "Segoe UI", "Microsoft YaHei", sans-serif';
					ctx.textAlign = 'center';
					// 笔记很多时只标注枢纽和悬停的节点，避免文字糊成一片
					if (nodes.length <= 40 || hovered || isHub) {
						ctx.fillStyle = hovered ? '#ffffff' : 'rgba(255, 255, 255, 0.45)';
						ctx.fillText(n.title, n.x, n.y + n.r + 16);
					}
				}
			}

			const nodeById = new Map();
			function ensureLoop() {
				if (running) return;
				running = true;
				const frame = () => {
					if (alpha > 0.02 || dragging) {
						tick();
					}
					draw();
					requestAnimationFrame(frame);
				};
				requestAnimationFrame(frame);
			}

			let hoverNode = null;
			let dragging = null;
			let dragMoved = false;
			let mouse = { x: -9999, y: -9999 };

			function nodeAt(x, y) {
				for (const n of nodes) {
					const dx = n.x - x;
					const dy = n.y - y;
					if (dx * dx + dy * dy <= (n.r + 8) ** 2) return n;
				}
				return null;
			}

			function toLocal(e) {
				const rect = canvas.getBoundingClientRect();
				return { x: e.clientX - rect.left, y: e.clientY - rect.top };
			}

			// 用 pointer 事件：鼠标和触屏都能拖拽
			canvas.addEventListener('pointermove', (e) => {
				const p = toLocal(e);
				mouse = p;
				if (dragging) {
					dragging.x = p.x;
					dragging.y = p.y;
					dragging.vx = 0;
					dragging.vy = 0;
					dragMoved = true;
					alpha = Math.max(alpha, 0.12);
				} else {
					hoverNode = nodeAt(p.x, p.y);
					canvas.style.cursor = hoverNode ? 'pointer' : 'default';
				}
			});

			canvas.addEventListener('pointerdown', (e) => {
				const p = toLocal(e);
				const n = nodeAt(p.x, p.y);
				if (n) {
					dragging = n;
					dragMoved = false;
					canvas.style.cursor = 'grabbing';
					e.preventDefault();
				}
			});

			window.addEventListener('pointerup', () => {
				if (dragging && !dragMoved) {
					const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
					location.href = `${base}/blog/${dragging.id}/`;
				}
				dragging = null;
				canvas.style.cursor = hoverNode ? 'pointer' : 'default';
			});

			canvas.addEventListener('pointerleave', () => {
				hoverNode = null;
				mouse = { x: -9999, y: -9999 };
			});

			window.addEventListener('resize', resize);
			resize();
		}
	}
</script>
