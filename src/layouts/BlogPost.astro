---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import Reveal from '../components/Reveal.astro';
import SkyLight from '../components/SkyLight.astro';
import { withBase } from '../consts';

// 文章页与关于页共用；关于页等静态页面可以不传日期
type Props = Omit<CollectionEntry<'blog'>['data'], 'pubDate'> & {
	pubDate?: Date;
	readingTime?: number;
	backlinks?: { id: string; title: string }[];
	related?: { id: string; title: string }[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags,
	readingTime,
	backlinks = [],
	related = [],
} = Astro.props;
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} />
		<style>
			.read-progress {
				position: fixed;
				top: 0;
				left: 0;
				height: 2px;
				width: 0%;
				background: var(--accent);
				z-index: 60;
				pointer-events: none;
			}
			.hero-image {
				max-width: 920px;
				margin: 3em auto 0;
			}
			.hero-image img {
				display: block;
				width: 100%;
				border-radius: 3px;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2.4em);
				margin: 0 auto;
				padding-top: 2em;
			}
			.title h1 {
				font-size: clamp(2rem, 5vw, 3rem);
				font-weight: 800;
				margin: 0.2em 0 0.4em;
			}
			.date {
				color: var(--faint);
				font-size: 0.8rem;
				letter-spacing: 0.1em;
				margin: 0 0 0.8em;
			}
			.last-updated-on {
				font-style: italic;
				margin-left: 1em;
			}
			.footnotes {
				width: 720px;
				max-width: calc(100% - 2.4em);
				margin: 3em auto 0;
				border-top: 1px solid var(--hairline-soft);
				padding-top: 2em;
			}
			.footnotes ul {
				list-style: none;
				margin: 1.2em 0 0;
				padding: 0;
			}
			.footnotes li {
				border-bottom: 1px solid var(--hairline-soft);
			}
			.footnotes a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1em;
				padding: 0.9em 0;
				text-decoration: none;
				color: var(--muted);
				transition: color 0.2s ease;
			}
			.footnotes a:hover {
				color: var(--text);
			}
			.footnotes .arr {
				opacity: 0;
				transition: opacity 0.2s ease;
			}
			.footnotes a:hover .arr {
				opacity: 1;
			}
		</style>
	</head>

	<body>
		<Header />
		<SkyLight />
		<div class="read-progress" aria-hidden="true"></div>
		<main class="wrap">
			{
				heroImage && (
					<div class="hero-image reveal">
						<Image width={1020} height={510} src={heroImage} alt="" />
					</div>
				)
			}
			<div class="prose" data-reveal-children>
				<div class="title">
					{
						pubDate && (
							<p class="date">
								<FormattedDate date={pubDate} />
								{readingTime && <span> · 约 {readingTime} 分钟</span>}
								{updatedDate && (
									<span class="last-updated-on">
										最后更新于 <FormattedDate date={updatedDate} />
									</span>
								)}
							</p>
						)
					}
					<h1>{title}</h1>
					{tags && tags.length > 0 && (
						<ul class="tags">
							{tags.map((t) => (
								<li class="tag">{t}</li>
							))}
						</ul>
					)}
					<hr />
				</div>
				<slot />
			</div>
			{
				backlinks.length > 0 && (
					<aside class="footnotes reveal">
						<p class="label">反向链接 · Backlinks</p>
						<ul>
							{backlinks.map((b) => (
								<li>
									<a href={withBase(`/blog/${b.id}/`)}>
										{b.title}
										<span class="arr" aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ul>
					</aside>
				)
			}
			{
				related.length > 0 && (
					<aside class="footnotes reveal">
						<p class="label">相关笔记 · Related</p>
						<ul>
							{related.map((r) => (
								<li>
									<a href={withBase(`/blog/${r.id}/`)}>
										{r.title}
										<span class="arr" aria-hidden="true">→</span>
									</a>
								</li>
							))}
						</ul>
					</aside>
				)
			}
		</main>
		<Footer />
		<Reveal />
		<script>
			// 顶部阅读进度条
			const bar = document.querySelector('.read-progress');
			if (bar) {
				const update = () => {
					const el = document.documentElement;
					const max = el.scrollHeight - el.clientHeight;
					bar.style.width = `${max > 0 ? (el.scrollTop / max) * 100 : 0}%`;
				};
				document.addEventListener('scroll', update, { passive: true });
				update();
			}
		</script>
	</body>
</html>
